{% capture footer_contents %}
  {% assign localized_first_name = site.data[site.active_lang].strings.first_name | default: site.first_name %}
  {% assign localized_middle_name = site.data[site.active_lang].strings.middle_name | default: site.middle_name %}
  {% assign localized_last_name = site.data[site.active_lang].strings.last_name | default: site.last_name %}
  &copy;
  {{- site.data[site.active_lang].strings.footer.copyright }}
  {{ site.time | date: '%Y' }}
  {{ localized_first_name }}
  {{ localized_middle_name }}
  {{ localized_last_name }}. {{ site.data[site.active_lang].strings.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    {{- site.data[site.active_lang].strings.footer.last_updated }}
    {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
