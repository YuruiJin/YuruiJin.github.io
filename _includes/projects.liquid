<div class="col">
  <article class="card h-100 project-card">
    <a class="project-card-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
      {% include project-cover.liquid %}
      <div class="card-body">
        <h3 class="card-title">{{ project.card_title | default: project.title }}</h3>
        <p class="card-text">{{ project.card_description | default: project.description }}</p>
        <span class="project-card-action">
          {{- site.data[site.active_lang].strings.projects.view_project }}
          <span aria-hidden="true">&rarr;</span></span
        >
      </div>
    </a>
    {% if project.github %}
      <a class="project-code-link" href="{{ project.github }}">{{ site.data[site.active_lang].strings.projects.view_code }}</a>
    {% endif %}
  </article>
</div>
