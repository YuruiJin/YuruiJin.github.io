@inproceedings{yu2023variable,
  abbr={CASE},
  bibtex_show={true},
  title={A Variable Stiffness Gripper with Dual Leaf-Spring Mechanism},
  author={Yu, Lei and Jin, Yurui and Qiao, Lin and Jin, Gumin and Qin, Siying and Chen, Yuqing},
  booktitle={2023 IEEE 19th International Conference on Automation Science and Engineering (CASE)},
  pages={1--7},
  year={2023},
  organization={IEEE},
  doi={10.1109/CASE56687.2023.10260296},
  publisher={IEEE},
  address={Auckland, New Zealand},
  abstract={The variable stiffness grippers predominantly change the stiffness in two ways: 1) incorporating soft materials but suffering from limited repeatability and high sensitivity to environmental changes; 2) utilizing mechanical structures but suffering from limited stiffness modulation range and heavy self-weight. To overcome the aforementioned drawbacks, we propose a novel variable stiffness gripper with dual leaf-spring mechanism. The dual leaf-spring gripper (DLSG) incorporates symmetrical pairs of roller bearings to constrain the leaf-spring's vertical deflection at the point of contact, while the stiffness modulation is achieved by changing the effective length of the leaf spring. Advantages with our design includes: 1) wide range of stiffness modulation, 2) compact mechatronic design, and 3) low self-weight. The stiffness modulation and grasping operation are independently controlled by two DC motors.},
  selected={true},
  preview={dlsg_preview_300x200.png}
}

@inproceedings{li2026robust,
  abbr={EECR},
  bibtex_show={true},
  title={Robust Infrared Reflective Sensors in Low-Cost Leader-Follower Mobile Robots System},
  author={Li, Zhiheng and Jin, Yurui and Zhang, Yanhua},
  booktitle={2026 International Conference on Electrical Engineering and Control of Robotics (EECR)},
  year={2026},
  month={April},
  preview={ap076_preview_300x200.png},
  note={Equal contribution (†)},
  abstract={This study evaluates the robust performance of low-cost infrared sensors in Leader-Follower tracking tasks under varying ambient-light conditions within a real-world environment. We use low-cost 3Pi 32U4 robot equipped with dual infrared sensors to measure angular deviation, and compare the two sensor types in a real-world environment. Experimental results show that the bump sensor offers superior robustness in distance and angle estimation under various lighting conditions, while the line sensor performs better in close-range line-following scenarios. This study provides quantitative guidance for sensor selection in low-cost robotic platforms and contributes to the development of small-scale robotic systems.},
  selected={true}
}

@article{jin2026physical,
  abbr={IEEE Access},
  bibtex_show={true},
  title={A Physical Imitation Learning Pipeline for Energy-Efficient Quadruped Locomotion Assisted by Parallel Elastic Joint},
  author={Jin, Yurui and others},
  journal={IEEE Access},
  year={2026},
  doi={10.48550/arXiv.2604.00611},
  arxiv={2604.00611},
  abstract={Due to brain-body co-evolution, animals' intrinsic body dynamics play a crucial role in energy-efficient locomotion, which shares control effort between active muscles and passive body dynamics—a principle known as Embodied Physical Intelligence. In contrast, robot bodies are often designed with one centralized controller that typically suppresses intrinsic body dynamics instead of exploiting it. This paper introduces Physical Imitation Learning (PIL), which distills a Reinforcement Learning (RL) control policy into physically implementable body responses that can be directly offloaded to passive Parallel Elastic Joints (PEJs), enabling the body to imitate part of the controlled behavior. Meanwhile, the residual policy commands the motors to recover the RL policy's performance. The outcome is an overall reduction in energy consumption, thanks to outsourcing parts of the control policy to the PEJs. Simulations show that the PIL approach can offload up to 87% of mechanical power to PEJs on flat terrain and 18% on rough terrain. Because body design is distilled from—rather than jointly optimized with—the control policy, PIL realizes brain-body co-design without expanding the search space with body design parameters, providing a computationally efficient route to task-specific Embodied Physical Intelligence applicable to a wide range of joint-based robot morphologies.},
  preview={pil_preview_300x200.png},
  note={Under Review},
  selected={true}
}
