---
layout: default
---
{% if page.cv_pdf %}
  {% if page.cv_pdf contains '://' %}
    {% assign cv_pdf_url = page.cv_pdf %}
  {% else %}
    {% assign cv_pdf_url = page.cv_pdf | prepend: '/' | prepend: site.active_lang | prepend: '/assets/pdf/' | relative_url | bust_file_cache %}
  {% endif %}
  {% if page.cv_pdf_download_name %}
    {% assign cv_pdf_filename = page.cv_pdf_download_name %}
  {% else %}
    {% assign cv_pdf_filename = page.cv_pdf | split: '/' | last %}
  {% endif %}
{% endif %}
{% assign localized_resume = site.active_lang | prepend: 'resume_' %}
{% unless site.data[localized_resume] %}
  <!-- use data from _data/LANG/cv.yml -->
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if page.cv_pdf %}
          <button
            type="button"
            class="btn btn-link float-right p-0 cv-protected-download text-reset"
            data-cv-pdf-url="{{ cv_pdf_url }}"
            data-cv-pdf-filename="{{ cv_pdf_filename }}"
            aria-label="Download CV PDF"
            title="Download CV PDF"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </button>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for entry in site.data[site.active_lang].cv %}
          <a class="anchor" id="{{ entry.title }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
            <div>
              {% if entry.type == 'list' %}
                {% include cv/list.liquid %}
              {% elsif entry.type == 'map' %}
                {% include cv/map.liquid %}
              {% elsif entry.type == 'nested_list' %}
                {% include cv/nested_list.liquid %}
              {% elsif entry.type == 'time_table' %}
                {% include cv/time_table.liquid %}
              {% elsif entry.type == 'list_groups' %}
                {% include cv/list_groups.liquid %}
              {% else %}
                {{ entry.contents }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% else %}
  <!-- use data from assets/json/resume_LANG.json -->
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if page.cv_pdf %}
          <button
            type="button"
            class="btn btn-link float-right p-0 cv-protected-download text-reset"
            data-cv-pdf-url="{{ cv_pdf_url }}"
            data-cv-pdf-filename="{{ cv_pdf_filename }}"
            aria-label="Download CV PDF"
            title="Download CV PDF"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </button>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for data in site.data[localized_resume] %}
          {% if site.jsonresume and site.jsonresume.size > 0 %}
            {% unless site.jsonresume contains data[0] %}
              {% continue %}
            {% endunless %}
          {% endif %}
          {% if data[0] == 'meta' or data[1].size == 0 %} {% continue %} {% endif %}
          {% assign localized_title = data[0] %}
          <a class="anchor" id="{{ site.data[site.active_lang].strings.cv[localized_title] }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv[localized_title] }}</h3>
            <div>
              {% case data[0] %}
                {% when 'basics' %}
                  {% include resume/basics.liquid %}
                {% when 'education' %}
                  {% include resume/education.liquid %}
                {% when 'work' %}
                  {% include resume/work.liquid %}
                {% when 'volunteer' %}
                  {% include resume/volunteer.liquid %}
                {% when 'projects' %}
                  {% include resume/projects.liquid %}
                {% when 'awards' %}
                  {% include resume/awards.liquid %}
                {% when 'skills' %}
                  {% include resume/skills.liquid %}
                {% when 'publications' %}
                  {% include resume/publications.liquid %}
                {% when 'languages' %}
                  {% include resume/languages.liquid %}
                {% when 'interests' %}
                  {% include resume/interests.liquid %}
                {% when 'certificates' %}
                  {% include resume/certificates.liquid %}
                {% when 'references' %}
                  {% include resume/references.liquid %}
                {% else %}

              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% endunless %}

{% if page.cv_pdf %}
  <div
    class="modal fade"
    id="cvDownloadProtectionModal"
    tabindex="-1"
    role="dialog"
    aria-labelledby="cvDownloadProtectionModalLabel"
    aria-hidden="true"
    data-cv-password-hash="{{ site.cv_password_hash | downcase }}"
  >
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="cvDownloadProtectionModalLabel">
            {% if site.active_lang == 'zh-cn' %}下载简历 PDF{% else %}Download CV PDF{% endif %}
          </h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <form id="cvDownloadProtectionForm">
          <div class="modal-body">
            <p class="small mb-3">
              {% if site.active_lang == 'zh-cn' %}
                请输入密码后下载已添加访问声明水印的 PDF。
              {% else %}
                Enter your password to download a watermarked PDF copy.
              {% endif %}
            </p>
            <div class="form-group">
              <label for="cvDownloadPasswordInput">
                {%- if site.active_lang == 'zh-cn' %}密码{% else %}Password{% endif -%}
              </label>
              <input type="password" class="form-control" id="cvDownloadPasswordInput" autocomplete="off" required>
            </div>
            <div class="form-group mb-0">
              <label for="cvDownloadVisitorInput">
                {% if site.active_lang == 'zh-cn' %}姓名 / 机构（可选）{% else %}Name / Organization (optional){% endif %}
              </label>
              <input
                type="text"
                class="form-control"
                id="cvDownloadVisitorInput"
                placeholder="{% if site.active_lang == 'zh-cn' %}例如：Yurui Jin / University{% else %}e.g., Yurui Jin / University{% endif %}"
              >
            </div>
            <div id="cvDownloadProtectionError" class="text-danger small mt-3 d-none" role="alert"></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">
              {% if site.active_lang == 'zh-cn' %}取消{% else %}Cancel{% endif %}
            </button>
            <button type="submit" class="btn btn-primary" id="cvDownloadProtectionSubmit">
              {% if site.active_lang == 'zh-cn' %}验证并下载{% else %}Verify & Download{% endif %}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <style>
    #cvDownloadProtectionModal .modal-content {
      background-color: var(--global-bg-color);
      color: var(--global-text-color);
      border-color: var(--global-divider-color);
    }

    #cvDownloadProtectionModal .form-control {
      background-color: var(--global-bg-color);
      color: var(--global-text-color);
      border-color: var(--global-divider-color);
    }
  </style>

  <script defer src="https://cdn.jsdelivr.net/npm/pdf-lib/dist/pdf-lib.min.js"></script>
  <script defer src="{{ '/assets/js/cv-protection.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
